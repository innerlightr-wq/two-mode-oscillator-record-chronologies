date-released: 2026-11-08
version: "congruence-records-v1.0.0"
license:
  - MIT
  - CC-BY-4.0
keywords:
  - record sequences
  - Diophantine approximation
  - quadratic irrationals
  - congruence conditions
  - Pell equation
  - two-mode oscillator spectrum
  - exact arithmetic
